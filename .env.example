# ==========================================================================
# Instagram Bot for Voroa — environment configuration
# Copy this file to .env for local development, or set the same variables in
# the Voroa dashboard (Service -> Environment) in production.
# Every variable below is read by config.py. Optional keys may stay empty.
#
# LIVE CONFIG VIA SSH (no dashboard restart needed):
#   python app.py --set-credentials <username>   # password is prompted hidden
#   python app.py --set-code <code>              # deliver a 2FA/OTP code
#   python app.py --clear-code                   # remove a stored code
# If IG_USERNAME/IG_PASSWORD are missing the bot WAITS for them (it stays up
# and SSH-reachable) instead of crashing — see README "Live configuration".
# ==========================================================================

# Application
APP_ENV=production
LOG_LEVEL=INFO

# Platform health probe port. The bot serves a tiny HTTP 200 endpoint here
# so Voroa's deploy health check passes (and keeps passing while the bot
# waits out an Instagram rate limit). Resolution: this value > $PORT
# (platform-managed) > 8080. Set 0 to disable the endpoint.
HEALTH_PORT=

# Web dashboard (manage the bot in a browser instead of the CLI).
# Served on the same port as the health probe. First visit offers a
# one-time setup form for the admin password when WEB_PASSWORD is empty.
WEB_ENABLED=true
WEB_USERNAME=admin
# Optional: fixed admin password (leave empty to use the first-run setup
# form on the dashboard itself). Never put a real password in this file.
WEB_PASSWORD=
# Optional: fixed session secret (random one is generated and stored on
# first start when empty).
WEB_SECRET_KEY=

# Instagram authentication (required to run the bot)
# Use a dedicated bot account. Unofficial API: automation can trigger
# Instagram checkpoints/challenges — see README before first run.
IG_USERNAME=
# Never put a real password here — this file is committed to git.
# Set IG_PASSWORD only in the local git-ignored .env or the Voroa dashboard.
IG_PASSWORD=
# Where the reusable login session is cached (file backend; see REDIS_URL).
IG_SESSION_FILE=auth/instagram_session.json
# One-time 2FA / verification code. Only needed when Instagram asks for it.
# Leave empty for normal starts. TIP: codes can also be delivered live,
# without restarting — via SSH run: python app.py --set-code <code>
IG_VERIFICATION_CODE=
# File the bot polls for a live one-time code (writable via SSH).
IG_VERIFICATION_FILE=auth/verification_code.txt
# Seconds to wait for a live code during a login attempt (0 = fail fast).
IG_VERIFICATION_WAIT=300
# Seconds between inbox polls (keep >= 15 to stay gentle on Instagram).
# Anti-suspension default is 60s; the bot slows down further when idle.
IG_POLL_INTERVAL=60
# How many inbox threads to inspect per poll.
IG_POLL_AMOUNT=20

# --- Anti-suspension ("gentle mode") — account-safety limits -------------
# The bot stays quiet and only acts when someone actually sends a command.
# After this many minutes without new messages it enters idle mode…
IG_IDLE_AFTER_MINUTES=10
# …and polls this often while idle. (Instagram private API has no push
# channel, so some polling is unavoidable; this keeps it minimal.)
IG_IDLE_POLL_INTERVAL=180
# Random human-like pause (seconds) before sending each reply.
IG_REPLY_DELAY_MIN=3
IG_REPLY_DELAY_MAX=10
# Hard floor: minimum seconds between ANY two Instagram API calls.
IG_MIN_REQUEST_GAP=5
# Replies allowed per rolling hour (protects against floods and bot-look).
IG_MAX_REPLIES_PER_HOUR=20
# Mark threads as seen — each mark is an extra request; off by default.
IG_MARK_SEEN=false
# Reply in group threads (false = 1:1 DMs only: fewer requests, fewer reports).
IG_REPLY_IN_GROUPS=false

# --- Login resilience (a failed login must never crash-loop) -------------
# If Instagram refuses a login (rate limit, challenge, typo'd password), the
# bot STAYS UP and retries slowly. Exiting would make the platform restart
# it every ~30 s and hammer the login endpoint — the very thing that
# triggers "verify it's you" and keeps rate limits active.
# Seconds before the first retry (doubles each attempt up to the max).
IG_LOGIN_RETRY_MIN=60
# Cap for that exponential backoff (seconds).
IG_LOGIN_RETRY_MAX=1800
# Cooldown (seconds) after a rate limit / challenge error: retried only
# this often, because retrying sooner keeps the block active.
IG_RATE_LIMIT_COOLDOWN=1200
# Persistent rate limits/challenges double the cooldown each consecutive
# failure, up to this cap (seconds).
IG_RATE_LIMIT_COOLDOWN_MAX=7200

# Session persistence backend.
# Voroa has NO persistent disks: the filesystem is wiped on every deploy.
# Set REDIS_URL to a Voroa managed Key Value (Redis) URL to keep the
# Instagram login session and processed-message state across deploys.
# When empty, state is kept in local files and survives process restarts
# within one deploy, but a redeploy forces a fresh login.
REDIS_URL=

# OpenRouter (used by /AI and /Gf) — https://openrouter.ai/docs
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models . Pick a ":free" model to
# avoid charges. "openrouter/free" auto-routes across free models.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional app attribution headers sent to OpenRouter (rankings).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=InstagramBot
# Max seconds to wait for one chat completion.
AI_REQUEST_TIMEOUT=60
# Bounded FIFO queue shared by /AI and /Gf. Exactly one request is active.
AI_MAX_QUEUE_SIZE=50
# Conversation memory per user and per mode (/AI vs /Gf are kept separate).
AI_MEMORY_TURNS=4
# Reject absurdly long prompts early (characters).
AI_MAX_PROMPT_CHARS=2000

# Gender and nationality predictions (/Gender)
# Both APIs work anonymously with a small free quota; keys are optional.
# One paid key from https://genderize.io works for both services.
GENDERIZE_API_KEY=
NATIONALIZE_API_KEY=

# Weather (/Weather) — Open-Meteo is keyless. metric (C, km/h) or imperial (F, mph).
WEATHER_UNITS=metric

# Anime APIs (/Anime) — both keyless. AniList primary, Jikan fallback.
ANILIST_ENABLED=true
JIKAN_ENABLED=true

# Anime images (/Pic) — waifu.im keyless. Male art falls back to nekos.best.
WAIFU_IM_ENABLED=true

# Wikipedia (/Wiki and /Celeb) — keyless; a descriptive User-Agent is required
# by the Wikimedia policy. Include a contact address in production, e.g.
# InstagramBot/1.0 (https://example.com/contact; bot@example.com)
WIKIPEDIA_LANGUAGE=en
WIKIPEDIA_USER_AGENT=InstagramBot/1.0

# Public username search (/Sherlock)
SHERLOCK_ENABLED=true
# Comma-separated subset of Sherlock sites (e.g. GitHub,Twitter,Instagram).
# Empty = the full Sherlock site list (several hundred outbound requests).
SHERLOCK_SITES=
# Per-site request timeout in seconds.
SHERLOCK_TIMEOUT=12

# Paused commands — future configuration only.
# /Num and /Id are disabled placeholders; these keys are read but no provider
# is integrated and no network calls are made. See src/commands/paused.py.
PHONE_LOOKUP_API_KEY=
INSTAGRAM_ID_API_KEY=
ENABLE_NUM_COMMAND=false
ENABLE_ID_COMMAND=false

# HTTP hardening used by every public-API client.
HTTP_TIMEOUT=20
HTTP_RETRIES=2
