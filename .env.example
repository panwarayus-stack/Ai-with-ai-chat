# ==========================================================================
# Instagram Bot for Voroa — environment configuration
# Copy this file to .env for local development, or set the same variables in
# the Voroa dashboard (Service -> Environment) in production.
# Every variable below is read by config.py. Optional keys may stay empty.
# ==========================================================================

# Application
APP_ENV=production
LOG_LEVEL=INFO

# Instagram authentication (required to run the bot)
# Use a dedicated bot account. Unofficial API: automation can trigger
# Instagram checkpoints/challenges — see README before first run.
IG_USERNAME=
IG_PASSWORD=
# Where the reusable login session is cached (file backend; see REDIS_URL).
IG_SESSION_FILE=auth/instagram_session.json
# One-time 2FA / verification code. Only needed when Instagram asks for it.
# Leave empty for normal starts.
IG_VERIFICATION_CODE=
# Seconds between inbox polls (keep >= 15 to stay gentle on Instagram).
IG_POLL_INTERVAL=20
# How many inbox threads to inspect per poll.
IG_POLL_AMOUNT=20

# Session persistence backend.
# Voroa has NO persistent disks: the filesystem is wiped on every deploy.
# Set REDIS_URL to a Voroa managed Key Value (Redis) URL to keep the
# Instagram login session and processed-message state across deploys.
# When empty, state is kept in local files and survives process restarts
# within one deploy, but a redeploy forces a fresh login.
REDIS_URL=

# OpenRouter (used by /AI and /Gf) — https://openrouter.ai/docs
OPENROUTER_API_KEY=
# Any model slug from https://openrouter.ai/models . Pick a ":free" model to
# avoid charges. "openrouter/free" auto-routes across free models.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional app attribution headers sent to OpenRouter (rankings).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=InstagramBot
# Max seconds to wait for one chat completion.
AI_REQUEST_TIMEOUT=60
# Bounded FIFO queue shared by /AI and /Gf. Exactly one request is active.
AI_MAX_QUEUE_SIZE=50
# Conversation memory per user and per mode (/AI vs /Gf are kept separate).
AI_MEMORY_TURNS=4
# Reject absurdly long prompts early (characters).
AI_MAX_PROMPT_CHARS=2000

# Gender and nationality predictions (/Gender)
# Both APIs work anonymously with a small free quota; keys are optional.
# One paid key from https://genderize.io works for both services.
GENDERIZE_API_KEY=
NATIONALIZE_API_KEY=

# Weather (/Weather) — Open-Meteo is keyless. metric (C, km/h) or imperial (F, mph).
WEATHER_UNITS=metric

# Anime APIs (/Anime) — both keyless. AniList primary, Jikan fallback.
ANILIST_ENABLED=true
JIKAN_ENABLED=true

# Anime images (/Pic) — waifu.im keyless. Male art falls back to nekos.best.
WAIFU_IM_ENABLED=true

# Wikipedia (/Wiki and /Celeb) — keyless; a descriptive User-Agent is required
# by the Wikimedia policy. Include a contact address in production, e.g.
# InstagramBot/1.0 (https://example.com/contact; bot@example.com)
WIKIPEDIA_LANGUAGE=en
WIKIPEDIA_USER_AGENT=InstagramBot/1.0

# Public username search (/Sherlock)
SHERLOCK_ENABLED=true
# Comma-separated subset of Sherlock sites (e.g. GitHub,Twitter,Instagram).
# Empty = the full Sherlock site list (several hundred outbound requests).
SHERLOCK_SITES=
# Per-site request timeout in seconds.
SHERLOCK_TIMEOUT=12

# Paused commands — future configuration only.
# /Num and /Id are disabled placeholders; these keys are read but no provider
# is integrated and no network calls are made. See src/commands/paused.py.
PHONE_LOOKUP_API_KEY=
INSTAGRAM_ID_API_KEY=
ENABLE_NUM_COMMAND=false
ENABLE_ID_COMMAND=false

# HTTP hardening used by every public-API client.
HTTP_TIMEOUT=20
HTTP_RETRIES=2
