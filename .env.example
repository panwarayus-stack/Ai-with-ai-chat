# Local development only. For Hugging Face Spaces, set WEB_PASSWORD and provider
# credentials in Settings → Variables and secrets. Never commit .env.
HOST=0.0.0.0
PORT=3000
WEB_USERNAME=owner
# At least 16 characters. The setup command generates a 32-byte random password.
WEB_PASSWORD=
# Absolute path. Sessions may start only in this directory or its real subdirectories.
WORKSPACE_DIR=~/opencode-workspace
# Optional dedicated CLI executable. Empty = use the pinned local npm dependency.
OPENCODE_BIN=
# Optional explicit executable paths if the service has a restricted PATH.
TMUX_BIN=
# Private server-side state. Relative paths resolve from this project directory.
DATA_DIR=./data
# Exact public HTTPS origin, recommended in production. No trailing path.
# Hugging Face app.py derives this from SPACE_HOST when PUBLIC_URL is unset.
# PUBLIC_URL=https://your-space.hf.space
# Only enable behind a trusted reverse proxy; number of trusted hops.
TRUST_PROXY=0
# Strict is the local default. Hugging Face app.py defaults to None+Secure for
# cross-site iframe embedding. None requires Secure=true (HTTPS).
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Modern CSP frame ancestors. Hugging Face app.py allows huggingface.co/*.hf.space.
FRAME_ANCESTORS="'none'"
# Recent ANSI output replayed on reconnect, per session (max 8 MiB).
REPLAY_BUFFER_BYTES=2097152
# Rotated terminal logs: two files, this size each (max 64 MiB).
LOG_FILE_BYTES=16777216
# Concurrent web sessions. Sessions survive browser reloads, so closed ones count.
MAX_SESSIONS=8
# Model provider credentials are forwarded to OpenCode automatically (for example
# ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY,
# GROQ_API_KEY, DEEPSEEK_API_KEY, OPENCODE_API_KEY). Without one, OpenCode uses its
# shared Zen free tier, which is capped per network and looks "limit reached" on a
# cloud host. You can also run `opencode auth login` inside the terminal instead.
# Extra provider variable names to forward (comma-separated), beyond the built-ins.
# Never use this for WEB_*, COOKIE_*, DATA_DIR, or *TOKEN* of this site.
PROVIDER_ENV_ALLOWLIST=
# Optional default model for new containers, written to WORKSPACE_DIR/opencode.json.
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# Optional comma-separated NAMES of any other environment variables to pass to
# OpenCode. Values are never returned by the web API.
TERMINAL_ENV_ALLOWLIST=
