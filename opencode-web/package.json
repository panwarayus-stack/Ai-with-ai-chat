{
  "name": "opencode-web",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated, persistent browser access to the real OpenCode terminal",
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart opencode-web",
    "pm2:stop": "pm2 stop opencode-web"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "node-pty": "1.1.0",
    "opencode-ai": "1.19.5",
    "ws": "8.22.1"
  },
  "devDependencies": { "pm2": "7.1.1" }
}
